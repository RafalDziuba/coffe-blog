---
export const prerender = true

import BasicLayout from '../layouts/BasicLayout.astro'
import NewsletterSection from '../components/NewsletterSection.astro'
import HeroSection from '../components/HeroSection/HeroSection.astro'
import CardsWrapper from '../components/BlogPost/CardsWrapper.astro'
---

<BasicLayout title="Blog o kawie" description="desc">
  <HeroSection slot="header" />
  <CardsWrapper heading="Wyróżnione artykuły" showOnlyFeatured={true} />
  <CardsWrapper heading="Najnowsze artykuły" maxPosts={6} />
  <NewsletterSection />
</BasicLayout>
