---

<section class="contact-section">
  <div class="contact-container">
    <!-- Nagłówek sekcji -->
    <div class="contact-header">
      <h1 class="contact-title">Skontaktuj się z nami</h1>
      <p class="contact-subtitle">
        Masz pytania o kawę, nasze kursy lub współpracę? Jesteśmy tutaj, aby pomóc!
      </p>
    </div>

    <!-- Dane kontaktowe -->
    <div class="contact-info-grid">
      <!-- Email -->
      <div class="contact-card">
        <div class="contact-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
            <polyline points="22,6 12,13 2,6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            ></polyline>
          </svg>
        </div>
        <div class="contact-details">
          <h3 class="contact-label">Email</h3>
          <a href="mailto:kontakt@zakawieni.pl" class="contact-value contact-link">
            kontakt@zakawieni.pl
          </a>
          <p class="contact-description">Odpowiadamy w ciągu 24 godzin</p>
        </div>
      </div>

      <!-- Telefon z zabezpieczeniem -->
      <div class="contact-card">
        <div class="contact-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </div>
        <div class="contact-details">
          <h3 class="contact-label">Telefon</h3>
          <div class="phone-protection">
            <div class="phone-checkbox-wrapper">
              <label class="phone-checkbox-label">
                <input type="checkbox" id="revealPhone" class="phone-checkbox" />
                <span class="checkbox-custom"></span>
                <span class="checkbox-text">Nie jestem robotem - pokaż numer</span>
              </label>
            </div>
            <div class="phone-number-wrapper">
              <span class="phone-number hidden" id="phoneNumber">
                <a href="tel:+48123456789" class="contact-value contact-link">+48 123 456 789</a>
              </span>
              <span class="phone-placeholder" id="phonePlaceholder">
                <span class="contact-value">••• ••• •••</span>
              </span>
            </div>
          </div>
          <p class="contact-description">Pon-Pt: 10:00 - 15:00</p>
        </div>
      </div>
    </div>

    <!-- Social Media -->
    <div class="social-section">
      <h2 class="social-title">Znajdziesz nas również na:</h2>
      <div class="social-links">
        <!-- Instagram -->
        <a
          href="https://www.instagram.com/zyciepokawie"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
            ></path>
          </svg>
          <span class="social-text">Instagram</span>
        </a>

        <!-- TikTok -->
        <a
          href="https://tiktok.com/@zakawieni"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
            <path
              d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"
            ></path>
          </svg>
          <span class="social-text">TikTok</span>
        </a>
        <!-- Facebook Group -->
        <a
          href="https://facebook.com/groups/zakawieni"
          target="_blank"
          rel="noopener noreferrer"
          class="social-link"
          aria-label="Grupa Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
            <path
              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
            ></path>
          </svg>
          <span class="social-text">Facebook</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const checkbox = document.getElementById('revealPhone') as HTMLInputElement
  const phoneNumber = document.getElementById('phoneNumber') as HTMLElement
  const phonePlaceholder = document.getElementById('phonePlaceholder') as HTMLElement

  if (checkbox && phoneNumber && phonePlaceholder) {
    checkbox.addEventListener('change', () => {
      if (checkbox.checked) {
        phoneNumber.classList.remove('hidden')
        phonePlaceholder.classList.add('hidden')
      } else {
        phoneNumber.classList.add('hidden')
        phonePlaceholder.classList.remove('hidden')
      }
    })
  }
</script>

<style>
  .contact-section {
    padding: 3rem 0;
  }

  .contact-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Header */
  .contact-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .contact-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .contact-subtitle {
    font-size: 1.2rem;
    color: #666;
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Contact Info Grid */
  .contact-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .contact-card {
    background: white;
    border: 2px solid #e0e0e0;
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    gap: 1.5rem;
  }

  .contact-icon {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .contact-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-label {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #999;
    margin: 0;
  }

  .contact-value {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--primary);
    word-break: break-all;
  }

  .contact-link {
    text-decoration: none;
    color: inherit;
    cursor: text;
  }

  .contact-description {
    font-size: 0.875rem;
    color: #666;
    margin: 0;
  }

  /* Phone Protection */
  .phone-protection {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .phone-checkbox-wrapper {
    margin-top: 0.5rem;
  }

  .phone-checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    user-select: none;
  }

  .phone-checkbox {
    position: absolute;
    opacity: 0;
    cursor: pointer;
  }

  .checkbox-custom {
    position: relative;
    width: 22px;
    height: 22px;
    border: 2px solid #ddd;
    border-radius: 4px;
    background: white;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .phone-checkbox:checked ~ .checkbox-custom {
    background: var(--primary);
    border-color: var(--primary);
  }

  .phone-checkbox:checked ~ .checkbox-custom::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 2px;
    width: 6px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .checkbox-text {
    font-size: 0.9rem;
    color: #666;
  }

  .phone-number-wrapper {
    position: relative;
    min-height: 30px;
  }

  .phone-number,
  .phone-placeholder {
    display: block;
  }

  .hidden {
    display: none;
  }

  .phone-number {
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .phone-placeholder .contact-value {
    color: #ccc;
    letter-spacing: 2px;
  }

  /* Social Section */
  .social-section {
    background: #f8f9fa;
    border-radius: 16px;
    padding: 2.5rem 2rem;
    text-align: center;
  }

  .social-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 2rem;
  }

  .social-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: white;
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.3s ease;
  }

  .social-link:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(3, 46, 21, 0.1);
  }

  .social-link svg {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
  }

  .social-text {
    font-weight: 600;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .contact-title {
      font-size: 2rem;
    }

    .contact-subtitle {
      font-size: 1rem;
    }

    .contact-info-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .contact-card {
      flex-direction: column;
      text-align: center;
    }

    .contact-icon {
      margin: 0 auto;
    }

    .phone-checkbox-label {
      justify-content: center;
    }

    .social-links {
      flex-direction: column;
      align-items: stretch;
    }

    .social-link {
      justify-content: center;
    }

    .social-section {
      padding: 2rem 1.5rem;
    }

    .social-title {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .contact-value {
      font-size: 1.1rem;
    }
  }
</style>
