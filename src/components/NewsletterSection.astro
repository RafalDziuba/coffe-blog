    align-items: center;
    flex-wrap: wrap;
    background-color: var(--primary);
    width: 100%;
    color: white;
  }

  .newsletter-heading {
    color: white;
    text-align: center;
    font-size: 1.875rem;
    line-height: 2.25rem;
    margin-bottom: 2.5rem;
  }

  .newsletter-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    justify-content: center; /* centrowanie zawartości (input + button) */
    max-width: 600px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .newsletter-form {
      grid-template-columns: 1fr auto; /* input + button w jednej linii */
