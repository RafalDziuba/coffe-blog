<section class="newsletter-section global-padding">
  <h2 class="newsletter-heading">
    Zapisz się na newsletter po autorskie przepisy, promocje i nowości
  </h2>

  <form class="newsletter-form">
    <!-- widocznie ukryta etykieta dla dostępności -->
    <label for="email" class="sr-only">Adres e-mail</label>
    <input
      class="newsletter-input"
      placeholder="Podaj swój email"
      type="email"
      name="email"
      id="email"
      required
      autocomplete="email"
      inputmode="email"
      maxlength="50"
    />
    <button class="newsletter-button" type="submit">Subskrybuj</button>
  </form>

  <p class="newsletter-subtext">
    Wiadomości będą wysyłane co miesiąc. Wypisanie się z newslettera jest możliwe w każdej chwili.
  </p>
</section>

<style>
  .newsletter-section {
    display: flex;
