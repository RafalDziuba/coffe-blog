---
interface Props {
  sortOption: string
}

const { sortOption = 'newest' } = Astro.props

const sortOptions = [
  { value: 'newest', label: 'Od najnowszych' },
  { value: 'oldest', label: 'Od najstarszych' },
]
---

<div class="sorting-container">
  <label for="sort-select" class="sorting-label">Sortuj według:</label>
  <div class="select-wrapper">
    <select
      id="sort-select"
      class="sorting-select"
      onchange="window.location = '/articles?sort=' + this.value + (new URLSearchParams(window.location.search).get('page') ? '&page=' + new URLSearchParams(window.location.search).get('page') : '')"
      aria-label="Sortuj artykuły"
    >
      {
        sortOptions.map((option) => (
          <option value={option.value} selected={sortOption === option.value}>
            {option.label}
          </option>
        ))
      }
    </select>
    <div class="select-arrow">▼</div>
  </div>
</div>

<style>
  .sorting-container {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 2rem;
  }

  .sorting-label {
    margin-right: 0.75rem;
    font-size: 0.95rem;
    color: #666;
  }

  .select-wrapper {
    position: relative;
    min-width: 180px;
  }

  .sorting-select {
    width: 100%;
    padding: 0.5rem 2rem 0.5rem 1rem;
    appearance: none;
    background-color: #fff;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.95rem;
    cursor: pointer;
    color: var(--primary, #032e15);
  }

  .sorting-select:hover {
    border-color: var(--primary-light, #034d26);
  }

  .sorting-select:focus {
    outline: none;
    border-color: var(--primary, #032e15);
    box-shadow: 0 0 0 2px rgba(3, 46, 21, 0.1);
  }

  .select-arrow {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.7rem;
    color: var(--primary, #032e15);
    pointer-events: none;
  }
</style>
