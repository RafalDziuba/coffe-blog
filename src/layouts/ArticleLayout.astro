---
import '../styles/global.css'
import TheNavigation from '../components/TheNavigation/TheNavigation.astro'
import TheFooter from '../components/TheFooter/TheFooter.astro'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  description: string
  publishDate: string
  updatedDate?: string
  author: string
  image: string | ImageMetadata
  tags: string[]
  canonicalURL?: string
  readTime: string
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  author,
  image,
  tags = [],
  readTime,
  canonicalURL = Astro.url.href,
} = Astro.props

// Format daty dla schema.org
const isoPublishDate = new Date(publishDate).toISOString()
const isoUpdatedDate = updatedDate ? new Date(updatedDate).toISOString() : isoPublishDate

// Format daty do wyświetlenia
const formattedPublishDate = new Date(publishDate).toLocaleDateString('pl-PL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})

const formattedUpdatedDate = updatedDate
  ? new Date(updatedDate).toLocaleDateString('pl-PL', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null

// Przygotowanie danych dla Schema.org
const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: new URL(typeof image === 'string' ? image : image.src, Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'CoffeeBlog',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/logo.png', Astro.site).toString(),
    },
  },
  datePublished: isoPublishDate,
  dateModified: isoUpdatedDate,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  keywords: tags.join(', '),
}

// Generowanie dynamicznego opisu Open Graph
const ogDescription =
  description || `Przeczytaj artykuł "${title}" na CoffeeBlog i dowiedz się więcej o kawie`

// Generowanie tagu dla Twitter Cards
const twitterCardType = image ? 'summary_large_image' : 'summary'

/** Absolutny URL do udostępniania (Open Graph / share) */
const sharePageUrl = new URL(canonicalURL, Astro.site ?? Astro.url).href

const shareText = `${title} — CoffeeBlog`
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(sharePageUrl)}`
const xShareUrl = `https://x.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(sharePageUrl)}`

const socialInstagramUrl = 'https://www.instagram.com/zyciepokawie'
const socialTikTokUrl = 'https://www.tiktok.com/@zakawieni'
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Podstawowe meta tagi -->
    <title>{title} | CoffeeBlog</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL - zapobiega problemom z duplikacją treści -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Meta tagi dla wyszukiwarek -->
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content={tags.join(', ')} />

    <!-- Open Graph dla mediów społecznościowych -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(typeof image === 'string' ? image : image.src, Astro.site)} />
    <meta property="og:site_name" content="CoffeeBlog" />
    <meta property="article:published_time" content={isoPublishDate} />
    {updatedDate && <meta property="article:modified_time" content={isoUpdatedDate} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={twitterCardType} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(typeof image === 'string' ? image : image.src, Astro.site)} />

    <!-- Struktura danych Schema.org dla artykułu -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Czas czytania dla usług wyszukiwania -->
    <meta property="article:read_time" content={readTime.replace(/\D/g, '')} />

    <!-- Favikony -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Zakawieni — blog o kawie"
      href={new URL('/rss.xml', Astro.site ?? Astro.url).href}
    />

    <!-- Preload głównych zasobów dla lepszej wydajności -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Style -->
    <slot name="head" />
  </head>
  <body>
    <TheNavigation />

    <main>
      <article class="article">
        <header class="article__header">
          <div class="article__meta">
            <time datetime={isoPublishDate} class="article__date">
              Opublikowano: {formattedPublishDate}
            </time>

            {
              formattedUpdatedDate && (
                <time datetime={isoUpdatedDate} class="article__updated-date">
                  Zaktualizowano: {formattedUpdatedDate}
                </time>
              )
            }

            <span class="article__author">Autor: {author}</span>
            <span class="article__read-time">Czas czytania: {readTime}</span>
          </div>

          <h1 class="article__title">{title}</h1>

          <div class="article__tags">
            {tags.map((tag) => <span class="article__tag">{tag}</span>)}
          </div>

          <div class="article__featured-image">
            {typeof image === 'string' ? (
              <img
                src={image}
                alt={`Zdjęcie do artykułu: ${title}`}
                width="1200"
                height="630"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <Image
                src={image}
                alt={`Zdjęcie do artykułu: ${title}`}
                width={1200}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="article__main-image"
              />
            )}
          </div>
        </header>

        <div class="article__content">
          <slot />
        </div>

        <footer class="article__footer">
          <div class="article__footer-bar">
            <div class="article__share">
              <h2>Udostępnij:</h2>
              <div class="article__share-buttons">
                <a
                  href={facebookShareUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Udostępnij na Facebooku — otwiera okno udostępniania z linkiem do artykułu"
                  class="article__share-button article__share-button--facebook"
                >
                  Facebook
                </a>
                <a
                  href={xShareUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Udostępnij na X — otwiera tworzenie wpisu z linkiem i tytułem"
                  class="article__share-button article__share-button--x"
                >
                  X
                </a>
              </div>
            </div>

            <div class="article__follow">
              <p class="article__follow-title">Zobacz, o czym nagrywamy:</p>
              <div class="article__follow-links">
                <a
                  href={socialInstagramUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="article__follow-link"
                  aria-label="Instagram — profil @zyciepokawie"
                >
                  <svg class="article__follow-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path
                      d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                    ></path>
                  </svg>
                </a>
                <a
                  href={socialTikTokUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="article__follow-link"
                  aria-label="TikTok — kanał @zakawieni"
                >
                  <svg class="article__follow-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path
                      d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"
                    ></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </footer>
      </article>

      <aside class="article__related">
        <slot name="related" />
      </aside>
    </main>

    <TheFooter />
  </body>
</html>

<style is:global>
  .article {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .article__header {
    margin-bottom: 2rem;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    color: #666;
    line-height: 1.5;
  }

  .article__title {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    line-height: 1.2;
    color: var(--primary, #5a7d2a);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .article__tag {
    display: inline-block;
    background-color: #f0f0f0;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: #666;
  }

  .article__featured-image {
    margin-bottom: 2rem;
    border-radius: 8px;
    overflow: hidden;
    background-color: #f0f0f0;
    aspect-ratio: 1200 / 630;
    position: relative;
  }

  /* Animacja skeleton loading zapobiegająca nagłemu skakaniu layoutu */
  .article__featured-image::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: skeleton-loading 1.5s infinite;
    z-index: 1;
  }

  @keyframes skeleton-loading {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .article__featured-image img,
  .article__main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 2;
  }

  .article__content {
    font-size: 1.1rem;
    line-height: 1.7;
    color: #333;
  }

  .article__content h2 {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .article__footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eee;
  }

  .article__footer-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem 1.5rem;
  }

  .article__share {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .article__share h2 {
    font-size: 1.25rem;
    margin: 0;
  }

  .article__share-buttons {
    display: flex;
    gap: 1rem;
  }

  .article__share-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .article__share-button:hover {
    opacity: 0.9;
  }

  .article__share-button--facebook {
    background-color: #1877f2;
    color: white;
  }

  .article__share-button--x {
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #000000;
  }

  .article__share-button--x:hover {
    opacity: 1;
    background-color: #242424;
    border-color: #242424;
  }

  .article__follow {
    margin-left: auto;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.65rem;
  }

  .article__follow-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #666;
    letter-spacing: 0.01em;
  }

  .article__follow-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: flex-end;
  }

  .article__follow-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 6px;
    color: #555;
    background: #f7f7f7;
    border: 1px solid #e8e8e8;
    text-decoration: none;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .article__follow-link:hover {
    color: var(--primary, #5a7d2a);
    background: #fafafa;
    border-color: #ddd;
    transform: translateY(-1px);
  }

  .article__follow-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .article__related {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }

  @media (min-width: 768px) {
    .article {
      padding: 3rem 2rem;
    }

    .article__title {
      font-size: 3rem;
    }
  }
</style>
