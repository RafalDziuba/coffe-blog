---
import TheFooter from "../components/TheFooter/TheFooter.astro";
import TheNavigation from "../components/TheNavigation/TheNavigation.astro";
import Seo from "../components/Seo/Seo.astro";
import "../styles/global.css";

import type { Props } from '../types/basicLayoutTypes'

const { title, description }: Props = Astro.props
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <Seo title={title} description={description} />
  </head>
  <body>
    <TheNavigation />
    <slot name="header" />
    <main class="main-content global-padding">
      <slot />
    </main>
    <slot name="newsletter" />
    <TheFooter />
  </body>
</html>

